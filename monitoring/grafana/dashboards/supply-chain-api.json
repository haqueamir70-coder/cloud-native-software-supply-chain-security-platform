{
  "id": null,
  "uid": "supply-chain-api",
  "title": "Supply Chain Demo API",
  "tags": ["devsecops", "supply-chain", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (path) (rate(http_requests_total[5m]))", "legendFormat": "{{path}}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 request latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{path}}", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total requests",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 8},
      "targets": [{"expr": "sum(http_requests_total)", "legendFormat": "Requests", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests by HTTP status",
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 8},
      "targets": [{"expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A"}]
    }
  ]
}
